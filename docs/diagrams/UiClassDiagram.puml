@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class CommandBox
Class ResultDisplay
Class StatusBarFooter
Class HelpWindow
Class ReminderDialog
Class ReminderAlertScheduler
Class PersonListPanel
Class ParentListPanel
Class SchedulePanel
Class PersonCard
Class ParentContactCard
Class ScheduleGrid
Class ScheduleSessionCard
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow

MainWindow *-down-> "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" StatusBarFooter
MainWindow --> "0..1" HelpWindow
MainWindow --> "0..1" ReminderDialog
MainWindow *-down-> "1" ReminderAlertScheduler
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" ParentListPanel
MainWindow *-down-> "1" SchedulePanel

PersonListPanel -down-> "*" PersonCard
ParentListPanel -down-> "*" ParentContactCard
SchedulePanel -down-> "1" ScheduleGrid
ScheduleGrid -down-> "*" ScheduleSessionCard

MainWindow -left-|> UiPart
CommandBox --|> UiPart
ResultDisplay --|> UiPart
StatusBarFooter --|> UiPart
HelpWindow --|> UiPart
PersonListPanel --|> UiPart
ParentListPanel --|> UiPart
SchedulePanel --|> UiPart
PersonCard --|> UiPart
ParentContactCard --|> UiPart

ReminderDialog .right.> Model
ReminderAlertScheduler .right.> Model
PersonCard .right.> Model
ParentContactCard .right.> Model
ScheduleSessionCard .right.> Model

UiManager -right-> Logic
MainWindow -right-> Logic

CommandBox -[hidden]right- ResultDisplay
ResultDisplay -[hidden]right- StatusBarFooter
StatusBarFooter -[hidden]right- HelpWindow
HelpWindow -[hidden]right- ReminderDialog
ReminderDialog -[hidden]right- ReminderAlertScheduler
ReminderAlertScheduler -[hidden]right- PersonListPanel
PersonListPanel -[hidden]right- ParentListPanel
ParentListPanel -[hidden]right- SchedulePanel
Logic -[hidden]down- Model

MainWindow -[hidden]-|> UiPart
@enduml
