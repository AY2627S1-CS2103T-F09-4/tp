<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" spacing="2">
    <padding>
      <Insets top="5" right="5" bottom="5" left="15" />
    </padding>
    <Label fx:id="commandWord" styleClass="cell_big_label" />
    <Label fx:id="format" styleClass="cell_small_label" wrapText="true" />
    <Label fx:id="description" styleClass="cell_small_label" wrapText="true" />
  </VBox>
</HBox>
