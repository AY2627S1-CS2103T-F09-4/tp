<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox alignment="CENTER" minHeight="105" prefWidth="90">
    <padding>
      <Insets top="5" right="5" bottom="5" left="10" />
    </padding>
    <ImageView fx:id="photo" fitHeight="72" fitWidth="72" preserveRatio="true" />
    <Label fx:id="photoPlaceholder" text="No photo" styleClass="cell_small_label" />
  </VBox>
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <TextFlow fx:id="name" styleClass="cell_big_label" />
      </HBox>
      <TextFlow fx:id="phone" styleClass="cell_small_label" />
      <TextFlow fx:id="email" styleClass="cell_small_label" />
      <TextFlow fx:id="linkedStudent" styleClass="cell_small_label" />
      <TextFlow fx:id="requirements" styleClass="cell_small_label" />
    </VBox>
  </GridPane>
</HBox>
